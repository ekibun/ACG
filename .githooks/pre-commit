#!/bin/sh
# 提交前拦截：Kotlin 走 ktlint、C++ 走 clang-format —— **只校验，不改文件**。
#
# 为什么是 git hook 而不是 CI：CI 要推到远端之后才跑，拦不住「改动进仓库」这个动作。
# 这里在 `git commit` 当场拦一次。
#
# 口径正本：skill `coding-style`（`.agents/skills/coding-style/`）+ 根 `.editorconfig`（Kotlin）
# 与根 `.clang-format`（C++）。本脚本只管「跑哪个命令」，不重复任何规则。
#
# 两道检查的分工：
#   - ktlint —— 格式与风格规则（缩进、标点、行尾空格）
#   - clang-format —— C++ 格式
#
# 装法（每个 clone 做一次；`.git/config` 是本机私有的，不入库）：
#     git config core.hooksPath .githooks
#   仓库里已按 100755 记录执行位，克隆下来一般就带着；若在 Linux / macOS 上丢了，
#   `chmod +x .githooks/pre-commit` —— git 对**没有执行位的 hook 是静默跳过**的。
#
# 本机依赖（缺了会**明确报错**，不会静默放行）：
#   - JDK 与 clang-format **都不用你配**：都由 `./gradlew` 的任务内部去找
#     （JDK 走 `gradle/gradle-daemon-jvm.properties` 钉的 toolchain，clang-format 由 `clangCheck`
#     经 `cxx/exec.cmd` 进 MSYS2 MINGW64 shell 命中，基线 mingw64 clang 22.1.8）。本脚本不设任何
#     环境变量、也不读 `$ACG_CLANG_FORMAT`。
#   - 暂存区里有 `.kt` / `.kts` 或 `cxx/` 下的源文件 → 触发 Gradle 闸门：一次跑 `ktlintCheck`
#     （查全仓 Kotlin）+ `clangCheck`（查 `cxx/{webview,quickjs,ffmpeg}` 三个固定顶层 C++ 文件，
#     见 `cxx/format.jni.sh`）—— 两者都「全查」，像 ktlintCheck 那样不挑单个文件。
#   - `gradlew` 还需要 `uname` / `xargs` / `sed` / `tr` / `cygpath` 可用（见下面的 PATH 修补）。
#
# 只想放行这一次：`git commit --no-verify`。别养成习惯 —— 跳过就白设了。
#
# ⚠️ 改本脚本时**只能用 shell 内建，加文件头点名的那几个工具**。
#   2026-09-17 踩过一次：原版用 `grep` 筛暂存区文件名，而 git 起的 hook 拿到的 PATH 是被
#   裁剪过的（见下一段），`grep` 找不到 → 文件列表变空 → 脚本判定「没有要检查的文件」
#   → `exit 0` **静默放行**。提交照常成功，什么都没查 —— 不报错、只失效，比不装 hook 更危险。
#   所以：不要用 `grep` / `awk` 去筛文件名，用 shell 自己的 `case`。

set -u

# —— PATH 修补 ——
# 实测（Git for Windows 2.55，从非 MSYS 终端提交）：git 传给 hook 的 PATH 里有 Git 的
# `cmd/`（只有 git.exe），**没有 Git 自带的 `usr/bin/`** —— 而 sed / uname / xargs /
# cygpath / tr 全在那儿。`gradlew` 这个 POSIX 脚本少了它们会死得很难看（`xargs` 缺失时
# 它只吐一句 "xargs is not available"）。这里从 git 自己的安装位置把 `usr/bin` 推出来，
# **不写死机器路径**：`git --exec-path` = `<安装根>/mingw64/libexec/git-core`，
# 退掉 `/libexec/*` 得 `<安装根>/mingw64`，再取同级就是 `<安装根>/usr/bin`。
#
# ⚠️ 两个坑（2026-09-17 实测）：
#   1) MSYS 的 PATH 搜索**不认** `C:/…` 这种 Windows 风格条目，只认 `/c/…` / `/usr/bin` 这种
#      POSIX 风格。而能把前者转成后者的 `cygpath` 恰好就在这个还没进 PATH 的目录里 ——
#      先有鸡还是先有蛋。所以用**内建的 `cd -P` + `pwd`** 归一化（MSYS 下它给出 `/usr/bin`）。
#   2) 别只靠 `[ -x ]` 判断成败，要**真的搜一次**（`command -v`）—— `-x` 通过而 PATH 搜不到
#      是上面第 1 点的典型表现。
# 其他平台 PATH 上本来就有这些工具，这个分支不会进。
git_usr_bin=
if ! command -v sed >/dev/null 2>&1; then
  exec_path=$(git --exec-path 2>/dev/null || true)
  root=${exec_path%/libexec/*}
  for cand in "$root/usr/bin" "${root%/*}/usr/bin"; do
    d=$( cd -P "$cand" 2>/dev/null && pwd )
    if [ -n "$d" ] && PATH="$d:$PATH" command -v sed >/dev/null 2>&1; then
      git_usr_bin=$d
      break
    fi
  done
fi

# 只看暂存区、只看这次要提交的。改个 .md 不应该等 Gradle。
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

# 检测暂存区里有没有 Kotlin / C++（决定是否触发 Gradle 闸门）。**只用 shell 内建**（理由见文件头）。
kt=
has_cxx=0
set -f                       # 文件名里的 * ? 不当通配符展开
for f in $staged; do
  case "$f" in
    *.kt | *.kts)
      kt="$kt$f
" ;;
    cxx/*)
      has_cxx=1 ;;
  esac
done
set +f

# 有 Kotlin 或 C++ 改动才触发 Gradle 闸门；闸门里两个都查（ktlintCheck 查全仓 Kotlin、
# clangCheck 查 cxx/ 三个固定顶层文件，都不挑单个文件，像 ktlintCheck 那样全查）。
if [ -z "$kt" ] && [ "$has_cxx" -eq 0 ]; then
  exit 0
fi

# —— Gradle 校验（Kotlin 走 ktlint；C++ 走 clang-format 任务）——
# 一次跑完 `ktlintCheck`（查全仓 Kotlin）+ `clangCheck`（查 cxx/ 三个固定顶层 C++ 文件，
# 见 `cxx/format.jni.sh`）。两者都是 `./gradlew` 任务，由 Gradle 任务内部去找 JDK / clang-format，
# 本脚本不设任何参数（不设 JAVA_HOME、不设 clang-format 路径）。
fail=0
echo "[pre-commit] Gradle checks: ktlintCheck / clangCheck..."

# 先确认 gradlew 真跑得起来。少了这一步，工具缺失时只会得到一句看不懂的报错，
# 甚至（像 `grep` 那次）什么都得不到。
missing=
for t in uname xargs sed tr cygpath; do
  if [ -n "$git_usr_bin" ]; then
    PATH="$git_usr_bin:$PATH" command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  else
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  fi
done

if [ -n "$missing" ]; then
  echo "[pre-commit] FAILED: tools required by gradlew are not on PATH: $missing" >&2
  echo "             git may have trimmed PATH for this hook -- add Git's usr/bin to PATH before committing." >&2
  fail=1
elif [ -z "${JAVA_HOME:-}" ] && ! command -v java >/dev/null 2>&1; then
  echo "[pre-commit] FAILED: java not found -- set JAVA_HOME or put java on PATH." >&2
  fail=1
else
  gradlew_ok=0
  if [ -n "$git_usr_bin" ]; then
    # 只给 gradlew 这一条命令补 PATH，缩小影响面。
    PATH="$git_usr_bin:$PATH" ./gradlew ktlintCheck clangCheck --continue --console=plain -q && gradlew_ok=1
  else
    ./gradlew ktlintCheck clangCheck --continue --console=plain -q && gradlew_ok=1
  fi
  if [ "$gradlew_ok" -ne 1 ]; then
    echo "[pre-commit] FAILED: Gradle checks did not pass (Gradle used -q; the report file it points to has the details)." >&2
    echo "             Kotlin auto-fix: ./gradlew ktlintFormat --continue" >&2
    echo "             WARNING: ktlintFormat can wrongly remove a still-used import (e.g. one needed for overload resolution) and break compilation -- re-run the three build gates afterwards." >&2
    echo "             C++ auto-fix: ./gradlew clangFormat --continue" >&2
    echo "             WARNING: after fixing, check whether Chinese comments got extra spaces from reflow (ReflowComments turns line breaks into spaces)." >&2
    fail=1
  fi
fi

exit $fail
